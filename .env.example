# Copy to .env and fill in. Every setting is optional — the defaults run the
# full stack locally against docker compose with no provider account.

# Async DSN. Must use the postgresql+asyncpg driver; a sync DSN is rejected at startup.
LEXGROUND_DATABASE_URL=postgresql+asyncpg://lexground:lexground@localhost:5432/lexground

# Synthesis provider. With no key the extractive baseline runs: no network, no spend.
# Anthropic wins if both are set; LEXGROUND_LLM_PROVIDER overrides the detection.
# LEXGROUND_ANTHROPIC_API_KEY=sk-ant-...
# LEXGROUND_DEEPSEEK_API_KEY=sk-...
# LEXGROUND_LLM_PROVIDER=deepseek
# LEXGROUND_ANTHROPIC_MODEL=claude-opus-5
# LEXGROUND_DEEPSEEK_MODEL=deepseek-chat

# hash      -> deterministic, no download. Used by the test suite.
# fastembed -> real multilingual embeddings. Used by CI and deployments.
LEXGROUND_EMBEDDING_BACKEND=hash

# Answerability backstops, not the abstention mechanism.
# Read docs/evaluation.md#abstention before changing either.
# LEXGROUND_MIN_LEXICAL_SCORE=0.05
# LEXGROUND_MIN_DENSE_SIMILARITY=0.15

# LEXGROUND_SYNTHESIS_EFFORT=medium
# LEXGROUND_CORS_ORIGINS=["http://localhost:3000"]
